{
  "name": "@spokospace/labels-niimbot",
  "version": "0.0.0",
  "description": "Import label templates designed in the NIIMBOT desktop app into the @spokospace/labels-render template format.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "pnpm --filter @spokospace/labels-core --filter @spokospace/labels-render --filter @spokospace/labels-niimbot build && node examples/serve.mjs"
  },
  "dependencies": {
    "@spokospace/labels-render": "workspace:*"
  },
  "devDependencies": {
    "@spokospace/labels-core": "workspace:*",
    "@types/node": "22.20.5"
  }
}
