{
  "name": "@spokospace/labels-core",
  "version": "0.0.0",
  "description": "NIIMBOT printer protocol and Web Bluetooth connection for printing labels from the browser.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
