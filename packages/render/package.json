{
  "name": "@spokospace/labels-render",
  "version": "0.0.0",
  "description": "Label template engine for NIIMBOT printers: a versioned, millimetre-based template format, validation and rendering to a black-and-white image.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@types/node": "22.20.5"
  }
}
